{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.4"
  },
  "diagnostics": {
    "globals": [
      "describe",
      "it",
      "assert_equal",
      "assert_true",
      "assert_false",
      "assert_nil",
      "assert_not_nil",
      "assert_diffs",
      "assert_warned",
      "OnSetText",
      "OnTransformAst",
      "ResolveRequire",
      "VM"
    ]
  },
  "workspace": {
    "library": ["src"],
    "checkThirdParty": false,
    "useGitIgnore": false,
    "ignoreDir": [".moonstone", ".ballad", ".git"]
  }
}
